# Copy to .env (never commit .env) or set these in your hosting provider.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/lorenzo
# Database TLS: disable | require (encrypted) | verify (encrypted + certificate checked).
# Leave unset to choose automatically: no TLS for private/internal hosts
# (e.g. postgres.railway.internal), encrypted for public hosts.
# DATABASE_SSL=require
# Session cookies only over HTTPS (default on in production).
SECURE_COOKIES=true
# Set when behind a proxy / load balancer so client IPs and HTTPS are detected correctly.
TRUST_PROXY=true
# Optional tuning
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
# Map background imagery and where the map opens before there are entries ("lat,lng,zoom").
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_DEFAULT_VIEW=39.5,-98.35,4
